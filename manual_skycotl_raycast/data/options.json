{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "goal":{
            "_comment": [
                "Using 'goal' as the name of an option let you override some of the generated goal parameters"
            ],
            "display_name": "The End Objective",
            "description": "How to End your Randomized playthrough.",
            "aliases": {"easiest": 0},
            "hidden": false
        },
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 20
            }
        }
    },
    "user": {
        "winged_light_run": {
            "description": [
                "Find Winged Light to earn checks and unlock your goal",
                "",
                "Please turn at least one Game Mode on"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Game Mode"
        },
        
        "spirit_emote_locks": {
            "description": [
                "Require Rescue Spirit items to pass through Spirit Gates or use Emotes",
                "",
                "Some checks are locked behind having a certain emote"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Locks"
        },
        "seasonal_emote_locks": {
            "description": [
                "Require Rescue Seasonal Spirit items to use Seasonal Emotes",
                "",
                "These are considered filler items and may be left out of the game",
                "if there are more items than locations"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Locks"
        },
        "friendship_emote_locks": {
            "description": [
                "Require Rescue Friendship Emote Spirit items to use Friendship Emotes"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Locks"
        },
        "cosmetic_locks": {
            "description": [
                "Start with no cosmetics or dyes unlocked"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Locks"
        },
        "prop_locks": {
            "description": [
                "Start with no props unlocked"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Locks"
        },

        "daily_music_challenge": {
            "description": [
                "Complete the Daily Music Challenge to earn a check"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Extra Challenges"
        },
        "hard_mode": {
            "description": [
                "Less wedges will be provided for reaching hard-to-reach places"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Extra Challenges"
        },

        "heart_traps": {
            "description": [
                "This trap will make you send a heart to a friend"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Traps"
        },
        "unskippable_cutscenes": {
            "description": [
                "This trap will make you sit through the next cutscene"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Traps"
        },
        "watch_the_incense_burn": {
            "description": [
                "This trap will make you visit the Tranquil Garden for a few minutes"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Traps"
        }
    }

}
